# Search index — generated by `node scripts/build-search.js`.
# Rebuilt automatically on every deploy by .github/workflows/deploy.yml, so
# there is nothing to commit and the index can never go stale.
pagefind/
pagefind-records/

# Build-time only. Holds the temporary HTML snapshots of the officials,
# sanctions and catalogue records that Pagefind reads to index them. Deleted
# again as soon as the index is built, and never deployed.
.search-build/

# Node, if you ever install anything locally
node_modules/
